*.c.inc         diff=c
*.h.inc         diff=c
*.m             diff=objc
*.py            diff=python
*.rs            diff=rust
*.rs.inc        diff=rust
Cargo.lock      diff=toml merge=binary

*.patch         -text -whitespace

# Force LF endings for shell scripts regardless of the platform's
# core.autocrlf setting. These scripts are invoked directly by bash during
# the build (e.g. scripts/xemu-version.sh, scripts/qemu-version.sh), and a
# CRLF checkout on Windows runners corrupts their `\`-newline continuations,
# causing silent build failures.
*.sh            text eol=lf
